{
  "name": "libra-view-web",
  "version": "0.0.0",
  "scripts": {
    "pretty": "prettier --write \"src/**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:libra-view-web": "node dist/libra-view-web/server/server.mjs",
    "gen-api": "npm run gen-api-tmdb && npm run gen-api-master && npm run gen-api-cine-registry",
    "gen-api-tmdb": "openapi-generator-cli generate -i ../libra-view-contract/tmdb/openapi_source.json -o ./src/generated/api/tmdb -g typescript-angular",
    "gen-api-master": "openapi-generator-cli generate -i ../libra-view-contract/libra-view/libra_view_master.api.yaml -o ./src/generated/api/master -g typescript-angular",
    "gen-api-cine-registry": "openapi-generator-cli generate -i ../libra-view-contract/libra-view/libra_view_cine_registry.api.yaml -o ./src/generated/api/cine-registry -g typescript-angular"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.5",
    "@angular/cdk": "^20.0.4",
    "@angular/common": "^20.0.5",
    "@angular/compiler": "^20.0.5",
    "@angular/core": "^20.0.5",
    "@angular/forms": "^20.0.5",
    "@angular/material": "^20.0.4",
    "@angular/platform-browser": "^20.0.5",
    "@angular/platform-browser-dynamic": "^20.0.5",
    "@angular/platform-server": "^20.0.5",
    "@angular/router": "^20.0.5",
    "@angular/ssr": "^20.0.4",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@rxweb/types": "^1.0.8",
    "express": "^4.18.2",
    "ngx-toastr": "^19.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.0.4",
    "@angular/cli": "^20.0.4",
    "@angular/compiler-cli": "^20.0.5",
    "@openapitools/openapi-generator-cli": "^2.23.4",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.3.3",
    "typescript": "~5.8.3"
  }
}
